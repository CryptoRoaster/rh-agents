# Native local PostgreSQL using localhost trust authentication only.
# Create the role and database first; see README.md. No production credentials.
DATABASE_URL=postgresql+asyncpg://rh_agents@localhost:5432/rh_agents
TRADING_MODE=OBSERVE
# LIVE_AUTONOMOUS is intentionally rejected by backend configuration.
# Recorded market API freshness window, in seconds.
MARKET_MAX_AGE_SECONDS=60
# Public market ingestion is deliberate and one-shot; no API key or RPC is required.
MARKET_PROVIDER=fixture
MARKET_CHAINS=robinhood,bsc
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_API_VERSION=20230203
# Verified against /networks on each pass; internal chain IDs remain independent.
GECKOTERMINAL_ROBINHOOD_NETWORK_ID=robinhood
GECKOTERMINAL_BSC_NETWORK_ID=bsc
GECKOTERMINAL_MAX_CHAINS=2
GECKOTERMINAL_POOLS_PER_CHAIN=3
# Detail requests are intentionally disabled; only zero is supported in Phase 1B.
GECKOTERMINAL_MAX_DETAIL_LOOKUPS=0
GECKOTERMINAL_MAX_REQUESTS=5
GECKOTERMINAL_MAX_HTTP_ATTEMPTS=8
GECKOTERMINAL_MAX_CONCURRENCY=1
GECKOTERMINAL_NETWORK_PAGES=3
GECKOTERMINAL_CONNECT_TIMEOUT_SECONDS=5
GECKOTERMINAL_READ_TIMEOUT_SECONDS=10
GECKOTERMINAL_TOTAL_TIMEOUT_SECONDS=30
GECKOTERMINAL_RETRIES=1
GECKOTERMINAL_RETRY_DELAY_SECONDS=2
GECKOTERMINAL_MAX_RETRY_AFTER_SECONDS=5

# Phase 1C native data runtime. Both services are disabled by default.
MARKET_WATCHER_ENABLED=false
# Delay AFTER completion. Minimum 60s; eight HTTP attempts/minute budget validation.
MARKET_WATCH_INTERVAL_SECONDS=90
EVM_RUNTIME_ENABLED=false
RH_CHAIN_ENABLED=false
RH_CHAIN_ID=4663
RH_RPC_HTTP_URL=
RH_RPC_WS_URL=
RH_CONFIRMATIONS_REQUIRED=12
BSC_CHAIN_ENABLED=false
BSC_CHAIN_ID=56
BSC_RPC_HTTP_URL=
BSC_RPC_WS_URL=
BSC_CONFIRMATIONS_REQUIRED=12
EVM_TIMEOUT_SECONDS=15
EVM_RETRIES=2
EVM_RETRY_DELAY_SECONDS=2
EVM_MAX_RETRY_DELAY_SECONDS=15
EVM_RECONNECT_ATTEMPTS=5
EVM_QUEUE_SIZE=64
EVM_RECOVERY_CHUNK_SIZE=100
EVM_REORG_WINDOW=64
EVM_STALE_SECONDS=60

# Phase 2B worker runtime. Disabled by default; no reasoning worker exists yet
# and no model provider is configured. Enabling this alone starts nothing.
WORKER_RUNTIME_ENABLED=false
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=5

# Phase 2C reasoning. Disabled by default: the API process never starts a worker
# and never makes a paid model call on boot. Enabling a provider alone starts
# nothing; the ORBIT runtime is launched explicitly.
REASONING_PROVIDER=disabled
REASONING_MODEL=claude-opus-5
REASONING_TIMEOUT_SECONDS=60
REASONING_MAX_OUTPUT_TOKENS=1024
# Placeholder only. The real key belongs in the ignored .env and is never logged,
# persisted, returned through an API route or included in evidence.
ANTHROPIC_API_KEY=
# REASONING_PROVIDER=codex runs GPT-5.5 through the local Codex CLI on its
# ChatGPT login instead of an API key (REASONING_MODEL is not used). Each call
# copies CODEX_HOME/auth.json into a throwaway isolated home behind the Seatbelt
# profile and release gates of src/evaluation/codex. Blank CODEX_EXECUTABLE
# means `codex` on PATH, which launchd's PATH does not include; blank
# CODEX_HOME means ~/.codex. REASONING_EFFORT=max is refused for codex.
# For the scout, set REASONING_TIMEOUT_SECONDS=120 in its own env file; the
# 60 s default above stays for everything else.
CODEX_EXECUTABLE=
CODEX_HOME=
# JEV shadow triage of new scout watches (TypeSafe). Off by default; a key
# alone selects nothing. Shadow only: nothing decides from it. JEV_MODEL must
# be a pinned version; jev-latest/jev-preview are refused.
FAST_REASONING_PROVIDER=disabled
# Placeholder only. The real key belongs in the scout env file, never in Git.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=10
JEV_MAX_ASSESSMENTS_PER_RUN=20
JEV_MAX_ASSESSMENTS_PER_DAY=1920
# Objective outcome labels for discovery candidates (labels only, no decision
# effect). Runs last in a scout run with its own GeckoTerminal request cap.
OUTCOME_SAMPLER_ENABLED=false
OUTCOME_MAX_REQUESTS_PER_RUN=10
OUTCOME_MAX_STREAMS_PER_RUN=40
ORBIT_WORKER_ENABLED=false
ORBIT_INPUT_MAX_AGE_SECONDS=900
ORBIT_DISCOVERY_LIQUIDITY_FLOOR_USD=25000

# Phase 2D ATLAS on-chain intelligence. Disabled by default. The safety policy
# itself is code-defined and versioned, not environment-mutable.
ATLAS_WORKER_ENABLED=false
ATLAS_SNAPSHOT_MAX_AGE_SECONDS=600
# ATLAS holder sources, one per chain; each defaults to disabled. Robinhood:
# blockscout (BLOCKSCOUT_API_KEY). BSC: nodereal (NODEREAL_API_KEY, the documented
# nr_getTokenHolders / nr_getTokenHolderCount methods) or moralis. A selected
# provider without its key refuses the configuration (ATLAS_PROVIDER_KEY_MISSING).
ATLAS_RH_HOLDER_PROVIDER=disabled
ATLAS_BSC_HOLDER_PROVIDER=disabled
BLOCKSCOUT_API_KEY=
NODEREAL_API_KEY=

# Phase 2G SIGNAL social data (Farcaster via Neynar).
# Disabled by default: a key here is not consent to spend provider credits, and
# selecting a provider still starts no worker and makes no call.
SIGNAL_SOCIAL_PROVIDER=disabled
NEYNAR_BASE_URL=https://api.neynar.com
NEYNAR_API_KEY=
SIGNAL_SOURCE_TIMEOUT_SECONDS=10
SIGNAL_NEYNAR_PAGE_SIZE=50
SIGNAL_NEYNAR_MAX_PAGES=2

# Phase 2N-C bounded market acquisition, performed by an explicitly started
# PAPER run. Disabled by default and separate from the run's own switch:
# consenting to a run is not consenting to that run calling a public API. It
# requires PAPER_RUNNER_ENABLED=true and MARKET_PROVIDER=geckoterminal, starts
# nothing on its own, and is unreachable from the API process and from the
# standalone `python -m src.markets.ingest --once` command, which keeps its own
# discovery-only permissions.
PAPER_RUNNER_MARKET_ACQUISITION_ENABLED=false
# Distinct markets one run may observe again. Every other cost here is
# proportional to this one.
PAPER_RUNNER_ACQUISITION_MAX_MARKETS=4
# Bounded discovery reads across all configured chains. Zero is meaningful: it
# acquires only what the open cases and positions depend on and looks for
# nothing new.
PAPER_RUNNER_ACQUISITION_MAX_DISCOVERY_REQUESTS=1
# Provider requests and HTTP attempts, the second including retries and helper
# queries such as network resolution. Both are applied to the provider's own
# budgets above, so a run can only tighten them and never loosen them.
PAPER_RUNNER_ACQUISITION_MAX_PROVIDER_REQUESTS=6
PAPER_RUNNER_ACQUISITION_MAX_HTTP_ATTEMPTS=8
# The whole acquisition stage, additionally bounded by whatever is left of the
# run's own runtime.
PAPER_RUNNER_ACQUISITION_MAX_SECONDS=60
# Pre-risk market refresh, composed under the same consent as acquisition.
# Immediately before a new risk request (and again before one re-asked after an
# ATLAS/ANCHOR source refresh) the case's market and every open position's
# market are observed again by exact pool locator, so SENTINEL reads
# observations younger than its own 30-second bound. Its own budget, per
# refresh, never the acquisition's; no discovery. If any needed market cannot
# be shown fresh, no risk request is sent.
PAPER_RUNNER_PRE_RISK_MARKET_MAX_REQUESTS=3
PAPER_RUNNER_PRE_RISK_MARKET_MAX_SECONDS=15

# Deterministic PAPER auto exits (policy PAPER_EXIT_V1), evaluated once per
# PAPER run before promotion and intake, executed only through the existing
# explicit exit and its SENTINEL SELL check. Disabled by default. The three
# policy values have NO defaults: production values are undecided and enabling
# the sweep without all three fails configuration. No model is involved. See
# docs/architecture/paper-auto-exits.md.
PAPER_AUTO_EXIT_ENABLED=false
# PAPER_EXIT_STOP_LOSS_BPS=
# PAPER_EXIT_TAKE_PROFIT_BPS=
# PAPER_EXIT_MAX_HOLDING_MINUTES=
PAPER_EXIT_INVALIDATE_BELOW_MIN_LIQUIDITY=true
PAPER_EXIT_MAX_PER_RUN=5

# Early discovery scout (`python -m src.runner.main --scout-once`). Disabled by
# default. It watches new pools from their first valid observation, asks ORBIT
# about them at fixed checkpoints and checks VECTOR history maturity. It never
# opens a case and holds no trading authority. With it enabled, the full PAPER
# run takes candidates only from PROMOTABLE watches. See
# docs/early-discovery-watch.md. Every bound is per scout run.
EARLY_SCOUT_ENABLED=false
EARLY_SCOUT_MAX_DISCOVERY_POOLS=10
# Discovery is decoupled from paid review capacity: every valid pool, up to the
# new-watch bound, becomes a watch; reviews wait in the due queue. Paid ORBIT
# calls are bounded per run and per UTC day (durable pre-call reservations).
EARLY_SCOUT_MAX_NEW_WATCHES_PER_RUN=10
EARLY_SCOUT_MAX_ORBIT_REVIEWS_PER_RUN=4
EARLY_SCOUT_MAX_ORBIT_REVIEWS_PER_DAY=96
# VECTOR history reads: their own GeckoTerminal transport and request budget
# (separate from discovery/refresh and the outcome sampler), paced so they never
# burst. Five slots go to checkpoints due within the hour, one to the backlog.
EARLY_SCOUT_HISTORY_MAX_REQUESTS_PER_RUN=6
EARLY_SCOUT_HISTORY_REQUEST_SPACING_SECONDS=6
# Re-observations by exact locator, batched per chain, for stale due watches only.
EARLY_SCOUT_MAX_REFRESH_MARKETS_PER_RUN=4
EARLY_SCOUT_MAX_BOOTSTRAP_STREAMS=100
