# Native local PostgreSQL using localhost trust authentication only.
# Create the role and database first; see README.md. No production credentials.
DATABASE_URL=postgresql+asyncpg://rh_agents@localhost:5432/rh_agents
TRADING_MODE=OBSERVE
# LIVE_AUTONOMOUS is intentionally rejected by backend configuration.
# Recorded market API freshness window, in seconds.
MARKET_MAX_AGE_SECONDS=60
# Public market ingestion is deliberate and one-shot; no API key or RPC is required.
MARKET_PROVIDER=fixture
MARKET_CHAINS=robinhood,bsc
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_API_VERSION=20230203
# Verified against /networks on each pass; internal chain IDs remain independent.
GECKOTERMINAL_ROBINHOOD_NETWORK_ID=robinhood
GECKOTERMINAL_BSC_NETWORK_ID=bsc
GECKOTERMINAL_MAX_CHAINS=2
GECKOTERMINAL_POOLS_PER_CHAIN=3
# Detail requests are intentionally disabled; only zero is supported in Phase 1B.
GECKOTERMINAL_MAX_DETAIL_LOOKUPS=0
GECKOTERMINAL_MAX_REQUESTS=5
GECKOTERMINAL_MAX_HTTP_ATTEMPTS=8
GECKOTERMINAL_MAX_CONCURRENCY=1
GECKOTERMINAL_NETWORK_PAGES=3
GECKOTERMINAL_CONNECT_TIMEOUT_SECONDS=5
GECKOTERMINAL_READ_TIMEOUT_SECONDS=10
GECKOTERMINAL_TOTAL_TIMEOUT_SECONDS=30
GECKOTERMINAL_RETRIES=1
GECKOTERMINAL_RETRY_DELAY_SECONDS=2
GECKOTERMINAL_MAX_RETRY_AFTER_SECONDS=5

# Phase 1C native data runtime. Both services are disabled by default.
MARKET_WATCHER_ENABLED=false
# Delay AFTER completion. Minimum 60s; eight HTTP attempts/minute budget validation.
MARKET_WATCH_INTERVAL_SECONDS=90
EVM_RUNTIME_ENABLED=false
RH_CHAIN_ENABLED=false
RH_CHAIN_ID=4663
RH_RPC_HTTP_URL=
RH_RPC_WS_URL=
RH_CONFIRMATIONS_REQUIRED=12
BSC_CHAIN_ENABLED=false
BSC_CHAIN_ID=56
BSC_RPC_HTTP_URL=
BSC_RPC_WS_URL=
BSC_CONFIRMATIONS_REQUIRED=12
EVM_TIMEOUT_SECONDS=15
EVM_RETRIES=2
EVM_RETRY_DELAY_SECONDS=2
EVM_MAX_RETRY_DELAY_SECONDS=15
EVM_RECONNECT_ATTEMPTS=5
EVM_QUEUE_SIZE=64
EVM_RECOVERY_CHUNK_SIZE=100
EVM_REORG_WINDOW=64
EVM_STALE_SECONDS=60

# Phase 2B worker runtime. Disabled by default; no reasoning worker exists yet
# and no model provider is configured. Enabling this alone starts nothing.
WORKER_RUNTIME_ENABLED=false
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=5

# Phase 2C reasoning. Disabled by default: the API process never starts a worker
# and never makes a paid model call on boot. Enabling a provider alone starts
# nothing; the ORBIT runtime is launched explicitly.
REASONING_PROVIDER=disabled
REASONING_MODEL=claude-opus-5
REASONING_TIMEOUT_SECONDS=60
REASONING_MAX_OUTPUT_TOKENS=1024
# Placeholder only. The real key belongs in the ignored .env and is never logged,
# persisted, returned through an API route or included in evidence.
ANTHROPIC_API_KEY=
ORBIT_WORKER_ENABLED=false
ORBIT_INPUT_MAX_AGE_SECONDS=900
ORBIT_DISCOVERY_LIQUIDITY_FLOOR_USD=25000

# Phase 2D ATLAS on-chain intelligence. Disabled by default. The safety policy
# itself is code-defined and versioned, not environment-mutable.
ATLAS_WORKER_ENABLED=false
ATLAS_SNAPSHOT_MAX_AGE_SECONDS=600
