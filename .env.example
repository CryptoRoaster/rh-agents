# Native local PostgreSQL using localhost trust authentication only.
# Create the role and database first; see README.md. No production credentials.
DATABASE_URL=postgresql+asyncpg://rh_agents@localhost:5432/rh_agents
TRADING_MODE=OBSERVE
# LIVE_AUTONOMOUS is intentionally rejected by backend configuration.
# Recorded market API freshness window, in seconds.
MARKET_MAX_AGE_SECONDS=60
# Public market ingestion is deliberate and one-shot; no API key or RPC is required.
MARKET_PROVIDER=fixture
MARKET_CHAINS=robinhood,bsc
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_API_VERSION=20230203
# Verified against /networks on each pass; internal chain IDs remain independent.
GECKOTERMINAL_ROBINHOOD_NETWORK_ID=robinhood
GECKOTERMINAL_BSC_NETWORK_ID=bsc
GECKOTERMINAL_MAX_CHAINS=2
GECKOTERMINAL_POOLS_PER_CHAIN=3
# Detail requests are intentionally disabled; only zero is supported in Phase 1B.
GECKOTERMINAL_MAX_DETAIL_LOOKUPS=0
GECKOTERMINAL_MAX_REQUESTS=5
GECKOTERMINAL_MAX_HTTP_ATTEMPTS=8
GECKOTERMINAL_MAX_CONCURRENCY=1
GECKOTERMINAL_NETWORK_PAGES=3
GECKOTERMINAL_CONNECT_TIMEOUT_SECONDS=5
GECKOTERMINAL_READ_TIMEOUT_SECONDS=10
GECKOTERMINAL_TOTAL_TIMEOUT_SECONDS=30
GECKOTERMINAL_RETRIES=1
GECKOTERMINAL_RETRY_DELAY_SECONDS=2
GECKOTERMINAL_MAX_RETRY_AFTER_SECONDS=5
