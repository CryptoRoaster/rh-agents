# early scout, every 5 minutes. Enabled only by start.sh --confirm --reason.
# systemd never starts the oneshot job again while it still runs: no overlap.
[Unit]
Description=RH Agents early scout, every 5 minutes.

[Timer]
Unit=rh-agents-scout.service
OnBootSec=180
OnUnitActiveSec=300
AccuracySec=5s
RandomizedDelaySec=10s

[Install]
WantedBy=timers.target
