# Local observation profile (macOS): discovery and market evidence only.
#
# Copy to ~/.config/rh-agents/observe.env (or $RH_AGENTS_OBSERVE_ENV) and keep
# it outside the repository. run-observe.sh reads ONLY the keys listed in its
# allowlist, refuses any other key, and starts the scout with an otherwise
# empty environment: every trading gate stays at its code default (off).
# No secret belongs here; the database URL must not carry a password.

# Isolated observation database only: rh_agents_observe[_suffix], local host.
DATABASE_URL=postgresql+asyncpg://YOUR_ROLE@localhost/rh_agents_observe

# Fixed by run-observe.sh (any other value is refused).
TRADING_MODE=OBSERVE
PAPER_RUNNER_ENABLED=false
EARLY_SCOUT_ENABLED=true
MARKET_PROVIDER=geckoterminal
MARKET_CHAINS=robinhood

# Discovery: the whole first page (20 pools); page 2 only on a saturated,
# non-overlapping page 1, within its own daily budget.
GECKOTERMINAL_MAX_REQUESTS=5
EARLY_SCOUT_MAX_DISCOVERY_POOLS=20
EARLY_SCOUT_DISCOVERY_PAGE2_ENABLED=true
EARLY_SCOUT_MAX_DISCOVERY_PAGE2_PER_DAY=72
EARLY_SCOUT_MAX_NEW_WATCHES_PER_RUN=20
# V4 pools first: V2/V3 pools are still recorded and watched, never reviewed.
EARLY_SCOUT_V4_PREFILTER_ENABLED=true

# VECTOR market history (GeckoTerminal OHLCV) and stale-watch refreshes.
EARLY_SCOUT_HISTORY_MAX_REQUESTS_PER_RUN=6
EARLY_SCOUT_MAX_REFRESH_MARKETS_PER_RUN=4

# ORBIT model reviews: 0 until a model budget is approved. Any other value
# also needs RH_AGENTS_OBSERVE_MODEL_BUDGET_APPROVED=yes.
EARLY_SCOUT_MAX_ORBIT_REVIEWS_PER_RUN=0
EARLY_SCOUT_MAX_ORBIT_REVIEWS_PER_DAY=0
RH_AGENTS_OBSERVE_MODEL_BUDGET_APPROVED=no

# The scout refuses to start without a composable model provider. Composing
# Codex only resolves the executable; with an ORBIT budget of 0 no process is
# ever started and no login is read.
REASONING_PROVIDER=codex
CODEX_EXECUTABLE=/opt/homebrew/bin/codex

# status.sh runs with the system PATH only: where psql lives. Never passed to
# the scout.
RH_AGENTS_OBSERVE_PSQL=/opt/homebrew/opt/postgresql@17/bin/psql
