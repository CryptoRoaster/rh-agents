; Outer read isolation for the Codex process itself.
;
; Codex's own `--sandbox read-only` is a *write* boundary: SandboxPolicy::
; has_full_disk_read_access returns true for every variant, seatbelt.rs turns
; that into a blanket `(allow file-read*)`, and the profile it builds wraps the
; commands the agent runs rather than the agent. Nothing there stops the Codex
; process from reading the repository, a .env file or an SSH key.
;
; This profile is applied to the Codex process itself, before it starts. The
; harness composes it after the platform section rather than using
; `(import ...)`: sandbox-exec resolves an import against its own search path,
; not against the directory the profile was loaded from.
;
; Paths arrive as `-D` parameters and must be *resolved* real paths: seatbelt
; matches the real filesystem, so /tmp would never match /private/tmp.

; ---- harness read allowlist ------------------------------------------------

; The Codex binary and the resources it ships with.
(allow file-read* file-map-executable (subpath (param "CODEX_VENDOR")))

; The empty evaluation workspace.
(allow file-read* (subpath (param "WORKSPACE")))

; The isolated CODEX_HOME. Holds the login state and nothing else.
(allow file-read* (subpath (param "CODEX_HOME")))

; The pinned catalog and the output schema, both inherited as descriptors.
; Nothing under the scratch directory is readable by path.
(allow file-read* (subpath "/dev/fd"))

; ---- harness write allowlist -----------------------------------------------

; Exactly one file, and only its contents. Codex 0.153.4 persists a refreshed
; ChatGPT token through FileAuthStorage::save, which truncates and rewrites
; CODEX_HOME/auth.json; without this the refresh would fail inside the sandbox.
;
; The directory itself stays unwritable, so no second file can appear beside it,
; and the user's own CODEX_HOME is not in the profile at all. Verified offline:
; the isolated copy can be read and rewritten, while creating any other file in
; the same directory is refused.
(allow file-write-data file-write-flags file-write-times
  (literal (param "AUTH_FILE")))

; ---- network ---------------------------------------------------------------

; The attempt has to reach the provider, so outbound TCP is open. Seatbelt
; matches sockets, not hostnames: there is no dependable way to narrow this to
; one endpoint here, and pretending otherwise would be worse than saying so.
;
; This is a deliberate, documented limit. What the outer sandbox enforces is the
; *file read* boundary; the network is the one thing the turn cannot do without.
(allow network-outbound (remote tcp))
(allow system-socket)
(allow mach-lookup
  (global-name "com.apple.dnssd.service")
  (global-name "com.apple.SystemConfiguration.configd"))
